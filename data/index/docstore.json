93\u3044\u3001\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u66f4\u65b0\u3092\u884c\u3044\u307e\u3059\u3002\n\n\u6307\u5b9a\u3055\u308c\u305f\u30d5\u30a9\u30eb\u30c0\u306b\u5bfe\u8c61\u3068\u306a\u308b\u6587\u66f8\u30d5\u30a1\u30a4\u30eb\u3092\u683c\u7d0d\u3057\u307e\u3059\u3002\u305d\u306e\u5f8c\u3001\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u66f4\u65b0\u7528\u306e\u30b9\u30af\u30ea\u30d7\u30c8\u3092\u5b9f\u884c\u3057\u307e\u3059\u3002\u5b9f\u884c\u7d50\u679c\u3068\u3057\u3066\u3001\u51e6\u7406\u3055\u308c\u305f\u6587\u66f8\u6570\u3084\u51e6\u7406\u6642\u9593\u3001\u30a8\u30e9\u30fc\u306e\u6709\u7121\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002\n\n4. \u30d9\u30af\u30c8\u30eb\u691c\u7d22\u78ba\u8a8d\u65b9\u6cd5\n\n\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u66f4\u65b0\u5f8c\u3001\u4ee5\u4e0b\u306e\u691c\u7d22\u30af\u30a8\u30ea\u3092\u7528\u3044\u3066\u3001\u691c\u7d22\u7d50\u679c\u304c\u9069\u5207\u306b\u8fd4\u3055\u308c\u308b\u304b\u78ba\u8a8d\u3057\u307e\u3059\u3002\n\n- \u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u66f4\u65b0\u6a5f\u80fd\n\n- \u30c6\u30b9\u30c8\u30b1\u30fc\u30b9\u756a\u53f7 TC-001\n\n- \u5c0f\u7267\n\n5. \u30c6\u30b9\u30c8\u60c5\u5831\u8a73\u7d30\n\n\u30c6\u30b9\u30c8\u5b9f\u65bd\u65e5\uff1a2025\u5e747\u670830\u65e5\n\n\u30c6\u30b9\u30c8\u62c5\u5f53\u8005\uff1a\u5c0f\u7267\n\n\u30c6\u30b9\u30c8\u74b0\u5883\uff1a\u30ed\u30fc\u30ab\u30eb\u958b\u767a\u74b0\u5883\uff08Mac\u3001Python 3.12.7\uff09\n\n\u30c6\u30b9\u30c8\u5bfe\u8c61\u30b7\u30b9\u30c6\u30e0\uff1a\u793e\u5185\u6587\u66f8\u30d9\u30af\u30c8\u30eb\u691c\u7d22\u30b7\u30b9\u30c6\u30e0\n\n6. \u60f3\u5b9a\u3055\u308c\u308b\u7d50\u679c\n\n\u6b63\u3057\u304f\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u304c\u66f4\u65b0\u3055\u308c\u3066\u3044\u308c\u3070\u3001\u691c\u7d22\u30af\u30a8\u30ea\u306b\u5bfe\u3057\u3066\u9069\u5207\u306a\u6587\u66f8\u30c1\u30e3\u30f3\u30af\u304c\u8fd4\u3055\u308c\u307e\u3059\u3002\u307e\u305f\u3001\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u66f4\u65b0\u6642\u306b\u30a8\u30e9\u30fc\u304c\u767a\u751f\u3057\u306